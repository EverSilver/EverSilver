# --- Server bind -------------------------------------------------------------
SWITCHAI_HOST=127.0.0.1
SWITCHAI_PORT=8088

# --- Default routing when model field has no "<provider>/" prefix ------------
SWITCHAI_DEFAULT_PROVIDER=openai
SWITCHAI_DEFAULT_MODEL=gpt-4o-mini

# --- Optional bearer auth (leave unset to disable auth) ----------------------
# SWITCHAI_AUTH_TOKEN=changeme

# --- Provider API keys (set the ones you use) --------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
REPLICATE_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=
DEEPGRAM_API_KEY=
# Ollama is local-only; no key needed.
