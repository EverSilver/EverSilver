# Eversilver LLM Backend — environment configuration.
# Copy to `.env` and fill in only the providers you actually use.
# The backend filters /v1/models by which keys are present, so unset
# providers simply don't appear.

# ── Server ─────────────────────────────────────────────────────────────
LLM_BACKEND_BIND_HOST=127.0.0.1
LLM_BACKEND_BIND_PORT=8088
LLM_BACKEND_LOG_LEVEL=info

# Path to the YAML model registry.
LLM_BACKEND_CONFIG_PATH=./config.yaml

# Optional bearer token. When set, /v1/* requires `Authorization: Bearer <token>`.
# Leave blank for an open localhost-bound proxy.
# LLM_BACKEND_AUTH_TOKEN=change-me

# Default chat model used when callers omit `model`.
LLM_BACKEND_DEFAULT_CHAT_MODEL=gemma3:1b-it-qat

# ── Ollama Cloud ───────────────────────────────────────────────────────
# Get a key by running `ollama signin` after installing the Ollama CLI,
# or visit https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Anthropic ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Mistral ────────────────────────────────────────────────────────────
# MISTRAL_API_KEY=

# ── DeepSeek ───────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=

# ── Google Gemini ──────────────────────────────────────────────────────
# GEMINI_API_KEY=

# ── Groq ───────────────────────────────────────────────────────────────
# GROQ_API_KEY=

# ── xAI Grok ───────────────────────────────────────────────────────────
# XAI_API_KEY=
